@startuml Sequence_Create_Alert

title Sequence Diagram - Create Alert with Duplicate Detection

actor "User" as User
participant "AlertController" as Controller
participant "CloudinaryService" as Cloudinary
participant "AlertsService" as Service
database "MongoDB" as DB
participant "AlertsGateway" as Gateway
participant "WebSocket Clients" as Clients

User -> Controller: POST /alerts\n(photo, type, lat, lon, description)
activate Controller

Controller -> Controller: Validate FormData\nParse coordinates

alt Photo provided
  Controller -> Cloudinary: uploadImage(file)
  activate Cloudinary
  Cloudinary --> Controller: imageUrl
  deactivate Cloudinary
end

Controller -> Service: createAlert(userId, dto)
activate Service

Service -> Service: validateCoordinates(lat, lon)

Service -> Service: findDuplicateAlert(type, lat, lon)
activate Service

Service -> DB: Find alerts\n(same type, <100m, <10min)
activate DB
DB --> Service: recentAlerts[]
deactivate DB

alt Duplicate Found
  Service -> Service: calculateDistanceInKilometers()
  Service --> Service: duplicateAlert
  
  Service -> Service: Add user to confirmedBy
  Service -> Service: confirmations++
  Service -> Service: calculateConfidenceScore()
  Service -> Service: updateAlertState()
  
  Service -> DB: save(duplicateAlert)
  activate DB
  DB --> Service: updatedAlert
  deactivate DB
  
  Service -> Gateway: emitAlertConfirmed(alert)
  activate Gateway
  Gateway -> Clients: broadcast "alert_confirmed"
  deactivate Gateway
  
  alt Status changed to VERIFIED
    Service -> Service: updateCreatorTrustScore(+0.1)
    Service -> Gateway: emitAlertVerified(alert)
    activate Gateway
    Gateway -> Clients: broadcast "alert_verified"
    deactivate Gateway
  end
  
  Service --> Controller: updatedAlert
  
else No Duplicate
  Service -> DB: create new Alert\n(status: ACTIVE)
  activate DB
  DB --> Service: newAlert
  deactivate DB
  
  Service -> Gateway: emitAlertCreated(alert)
  activate Gateway
  Gateway -> Clients: broadcast "alert_created"
  deactivate Gateway
  
  Service --> Controller: newAlert
end

deactivate Service

Controller --> User: 200 OK\nalert data
deactivate Controller

@enduml

