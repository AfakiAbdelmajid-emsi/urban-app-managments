@startuml Sequence_Confirm_Alert

title Sequence Diagram - Confirm Alert (Trust System)

actor "User" as User
participant "AlertController" as Controller
participant "AlertsService" as Service
participant "UsersService" as UserService
database "MongoDB" as DB
participant "AlertsGateway" as Gateway
participant "WebSocket Clients" as Clients

User -> Controller: POST /alerts/:id/confirm
activate Controller

Controller -> Service: confirmAlert(id, voterId)
activate Service

Service -> DB: findById(id)
activate DB
DB --> Service: alert
deactivate DB

Service -> Service: Check if user is creator
note right: Throw error if true

Service -> Service: Check if already confirmed
note right: Throw error if true

alt Previously denied
  Service -> Service: Remove from deniedBy\ndenials--
end

Service -> Service: Add to confirmedBy\nconfirmations++

Service -> Service: calculateConfidenceScore()
activate Service

loop For each user in confirmedBy
  Service -> UserService: getUser(userId)
  activate UserService
  UserService -> DB: findById(userId)
  DB --> UserService: user
  UserService --> Service: user.trustScore
  deactivate UserService
  Service -> Service: confidence += trustScore
end

Service -> Service: confidence -= denials
Service --> Service: confidenceScore
deactivate Service

Service -> DB: save(alert)
activate DB
DB --> Service: savedAlert
deactivate DB

Service -> Service: updateAlertState(id, confidence)
activate Service

alt confirmations >= 3
  Service -> DB: Update status to VERIFIED
  Service --> Service: newStatus = VERIFIED
else confidence <= -3
  Service -> DB: Update status to REJECTED
  Service --> Service: newStatus = REJECTED
else
  Service --> Service: newStatus = ACTIVE
end

deactivate Service

alt Status changed to VERIFIED
  Service -> Service: updateCreatorTrustScore(+0.1)
  activate Service
  Service -> DB: Update creator.trustScore += 0.1
  deactivate Service
  
  Service -> Gateway: emitAlertVerified(alert)
  activate Gateway
  Gateway -> Clients: broadcast "alert_verified"
  deactivate Gateway
end

alt Status changed to REJECTED
  Service -> Service: updateCreatorTrustScore(-0.2)
  activate Service
  Service -> DB: Update creator.trustScore -= 0.2
  deactivate Service
  
  Service -> Gateway: emitAlertRejected(alert)
  activate Gateway
  Gateway -> Clients: broadcast "alert_rejected"
  deactivate Gateway
end

Service -> Gateway: emitAlertConfirmed(alert)
activate Gateway
Gateway -> Clients: broadcast "alert_confirmed"
deactivate Gateway

Service -> Gateway: emitConfidenceUpdated(alert)
activate Gateway
Gateway -> Clients: broadcast "alert_confidence_updated"
deactivate Gateway

Service --> Controller: updatedAlert
deactivate Service

Controller --> User: 200 OK\nupdated alert
deactivate Controller

@enduml

