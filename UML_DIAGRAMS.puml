@startuml Class_Diagram

title Class Diagram - Core Domain Models

class User {
  +_id: ObjectId
  +email: string
  +password: string (hashed)
  +name?: string
  +trustScore: number
  +createdAt: Date
  --
  +getTrustScore(): number
  +updateTrustScore(delta: number): void
}

class Alert {
  +_id: ObjectId
  +userId: string
  +type: AlertType
  +description?: string
  +latitude: number
  +longitude: number
  +photo?: string
  +roadName?: string
  +fullAddress?: string
  +confirmations: number
  +denials: number
  +confidenceScore: number
  +confirmedBy: string[]
  +deniedBy: string[]
  +verified: boolean
  +status: AlertStatus
  +createdAt: Date
  +expiresAt: Date
  --
  +calculateConfidence(): number
  +updateStatus(): AlertStatus
