@startuml Activity_Duplicate_Detection

title Activity Diagram - Duplicate Alert Detection

start

:User submits alert\n(type, lat, lon);

:Validate coordinates;

:Query recent alerts\n(same type, <10 min);

if (Recent alerts found?) then (yes)
  
  while (For each recent alert) is (more alerts)
    :Calculate distance\n(Haversine formula);
    
    if (Distance <= 100m?) then (yes)
      :Found duplicate!;
      
      :Check if user already\nin confirmedBy;
      
      if (Already confirmed?) then (yes)
        :Return existing alert\n(no changes);
        stop
      else (no)
        :Add user to confirmedBy;
        :Increment confirmations;
        :Calculate new confidence;
        
        if (Confirmations >= 3?) then (yes)
          :Update status to VERIFIED;
          :Update creator trust +0.1;
          :Emit alert_verified;
        else (no)
          :Keep status ACTIVE;
        endif
        
        :Emit alert_confirmed;
        :Emit confidence_updated;
        :Return updated alert;
        stop
      endif
      
    else (no)
      :Continue to next alert;
    endif
    
  endwhile (no more)
  
endif

:No duplicate found;
:Create new alert;
:Set status = ACTIVE;
:Set confirmations = 0;
:Set confidenceScore = 0;

:Emit alert_created;

:Return new alert;

stop

@enduml

